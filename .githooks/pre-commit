#!/bin/bash
# Pre-commit hook: プラグイン変更時のバージョンバンプ必須チェック

staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
  exit 0
fi

# **変異テストの実行中はコミットさせない。** 実行中はディスク上のファイルが変異体に
# 差し替わっており、その状態で `git add` すると**変異が index に入る**（実測: `and` を
# `or` に変えた行がステージされていた）。ツール側のガードは「対象ファイルの外部編集」を
# 見ているだけで、staging は素通りする。ジャーナルの実在で決定的に判定できる
if [ -f .mutation-test-journal.json ]; then
  echo "変異テストが実行中です（.mutation-test-journal.json あり）。"
  echo "  実行中は変異体がディスク上にあるため、コミットすると変異が入ります。"
  echo "  完了を待ってから、staged の内容を確認してコミットしてください:"
  echo "    git diff --cached   # 意図しない演算子の反転が混ざっていないか"
  exit 1
fi

errors=()

for plugin_json in */.claude-plugin/plugin.json; do
  [ -f "$plugin_json" ] || continue
  plugin_dir=$(echo "$plugin_json" | cut -d'/' -f1)

  # プラグイン内の変更（plugin.json 自体は除外）
  content_changes=$(echo "$staged_files" | grep "^${plugin_dir}/" | grep -v "^${plugin_dir}/.claude-plugin/plugin.json$")

  if [ -n "$content_changes" ]; then
    # plugin.json もステージされているか（= バージョンバンプされたか）
    version_bumped=$(echo "$staged_files" | grep "^${plugin_dir}/.claude-plugin/plugin.json$")

    if [ -z "$version_bumped" ]; then
      errors+=("${plugin_dir}")
    fi
  fi
done

if [ ${#errors[@]} -gt 0 ]; then
  echo "Version bump required:"
  echo ""
  for plugin in "${errors[@]}"; do
    echo "  ${plugin}/.claude-plugin/plugin.json"
    echo "  changed files:"
    echo "$staged_files" | grep "^${plugin}/" | grep -v ".claude-plugin/plugin.json" | sed 's/^/    /'
    echo ""
  done
  echo "  .claude-plugin/marketplace.json も同期すること"
  echo ""
  echo "  MAJOR: 破壊的変更（スキル/コマンドの削除・リネーム）"
  echo "  MINOR: 機能追加（新スキル/コマンド、既存機能拡張）"
  echo "  PATCH: 修正（バグ修正、ドキュメント、リファクタ）"
  exit 1
fi

# CHANGELOG.md チェック: バージョンバンプ時は CHANGELOG.md も更新必須
changelog_errors=()

for plugin_json in */.claude-plugin/plugin.json; do
  [ -f "$plugin_json" ] || continue
  plugin_dir=$(echo "$plugin_json" | cut -d'/' -f1)

  # plugin.json がステージされている（= バージョンバンプあり）
  version_bumped=$(echo "$staged_files" | grep "^${plugin_dir}/.claude-plugin/plugin.json$")

  if [ -n "$version_bumped" ]; then
    # CHANGELOG.md もステージされているか
    changelog_updated=$(echo "$staged_files" | grep "^${plugin_dir}/CHANGELOG.md$")

    if [ -z "$changelog_updated" ]; then
      changelog_errors+=("${plugin_dir}")
    fi
  fi
done

if [ ${#changelog_errors[@]} -gt 0 ]; then
  echo "CHANGELOG.md update required:"
  echo ""
  for plugin in "${changelog_errors[@]}"; do
    echo "  ${plugin}/CHANGELOG.md"
  done
  echo ""
  echo "  バージョンバンプ時は CHANGELOG.md も更新すること"
  echo "  形式: Keep a Changelog (https://keepachangelog.com/ja/1.0.0/)"
  echo "  feat → Added / fix → Fixed / refactor → Changed"
  exit 1
fi

# **ゲートスクリプトの欠落は「違反なし」ではなく「検査していない」**（GitHub issue #176）。
# 以前は `[ -f ]` / `[ -d ]` で存在しなければ黙って通していたが、それだと検査を消すだけで
# commit が素通りする。同じリポジトリの他の検査（INDEX.md 欠落を error にする等）と流儀を揃える
for gate in \
  .claude-plugin/scripts/validate-ssot.sh \
  .claude-plugin/scripts/validate_plugin_quality.py \
  .claude-plugin/scripts/plugin-eval.sh
do
  if [ ! -f "$gate" ]; then
    echo "❌ 検査スクリプトが見つかりません: $gate"
    echo "  検査を実行できないため commit を止めます（欠落を「違反なし」として通さない）"
    exit 1
  fi
done
if [ ! -d .claude-plugin/scripts/tests ]; then
  echo "❌ 回帰テストのディレクトリが見つかりません: .claude-plugin/scripts/tests"
  echo "  検査を実行できないため commit を止めます（欠落を「違反なし」として通さない）"
  exit 1
fi

# plugin eval の鮮度チェック: eval ケース（`<plugin>/evals/`）を持つプラグインで、eval の
# 入力（skills / commands / agents / references / evals）に staged 変更があるなら、
# **その内容に対して `claude plugin eval` を回して閾値を満たした記録**が要る。
#
# 判定は `plugin-eval.sh` が eval 実行時に残す `.last-eval` の指紋（入力ファイル内容の
# cksum）と、いま同じ関数で取り直した指紋の一致。mtime や results/ の存在は見ない
# （results/ は gitignore で、別マシンには無い。指紋なら「この内容を測った」と言える）。
# 実行は paid（子 claude が自分の認証で走る）なので **ここでは回さない**。止めて、
# 回すコマンドを示すだけ。`PLUGIN_EVAL_SKIP=1` で 1 回だけ迂回できる
# （別マシンで小さな typo を直すときなど。CI には eval が無いので迂回しても落ちない）
if [ "${PLUGIN_EVAL_SKIP:-}" != "1" ]; then
  eval_errors=()
  for plugin_json in */.claude-plugin/plugin.json; do
    [ -f "$plugin_json" ] || continue
    plugin_dir=$(echo "$plugin_json" | cut -d'/' -f1)
    [ -d "${plugin_dir}/evals" ] || continue
    # ケース定義が 1 つも無い evals/（results/ だけ等）は対象外
    if ! find "${plugin_dir}/evals" -type f \( -name prompt.md -o -name case.yaml \) \
         -not -path "*/evals/results/*" 2>/dev/null | grep -q .; then
      continue
    fi
    eval_inputs=$(echo "$staged_files" \
      | grep -E "^${plugin_dir}/(skills|commands|agents|references|evals)/" || true)
    [ -n "$eval_inputs" ] || continue

    marker="${plugin_dir}/evals/results/.last-eval"
    current_fp=$(bash .claude-plugin/scripts/plugin-eval.sh --fingerprint "$plugin_dir")
    recorded_fp=""; recorded_rc=""
    if [ -f "$marker" ]; then
      recorded_fp=$(sed -n 's/^fingerprint=//p' "$marker")
      recorded_rc=$(sed -n 's/^exit=//p' "$marker")
    fi
    if [ "$recorded_fp" != "$current_fp" ]; then
      eval_errors+=("${plugin_dir}: この内容で eval を回していない（記録 ${recorded_fp:-なし} / 現在 ${current_fp}）")
    elif [ "$recorded_rc" != "0" ]; then
      eval_errors+=("${plugin_dir}: 直近の eval が閾値未満で終わっている（exit ${recorded_rc}）")
    fi
  done
  if [ ${#eval_errors[@]} -gt 0 ]; then
    echo "plugin eval required:"
    echo ""
    for e in "${eval_errors[@]}"; do
      echo "  ${e}"
    done
    echo ""
    echo "  スキル本文 / command / references / eval ケースを変えたら、その内容で eval を回してから commit する:"
    for e in "${eval_errors[@]}"; do
      echo "    bash .claude-plugin/scripts/plugin-eval.sh ${e%%:*}"
    done
    echo "  結果は <plugin>/evals/results/<timestamp>/report.html（gitignore）。迂回は PLUGIN_EVAL_SKIP=1 git commit ..."
    exit 1
  fi
fi

# SSoT 同期チェック: plugin.json ↔ marketplace.json / _requirements ↔ check-deps.sh
bash .claude-plugin/scripts/validate-ssot.sh && ssot_rc=0 || ssot_rc=$?
if [ "$ssot_rc" = "1" ]; then
  echo ""
  echo "  plugin.json が SSoT。派生物 (marketplace.json / check-deps.sh) を同期してください"
  exit 1
elif [ "$ssot_rc" != "0" ]; then
  # 判定不能（jsonschema 不在・JSON 破損等）。**通さない**: ここを素通しすると
  # 「ローカルは緑・CI は赤」の非対称が push まで見えない（GitHub issue #140）
  echo ""
  echo "  SSoT 検査が判定不能（exit ${ssot_rc}）。前提を入れてから再実行してください"
  echo "  この検査は CI では前提込みで走るため、ここで通すと差が push まで残ります"
  exit 1
fi

# プラグイン品質チェック（errors のみブロック。warnings は通す）
# CI と同じ検査を commit 前に走らせ、「pre-commit は通るが CI で落ちる」非対称を塞ぐ
# **出力は 1 回の実行から取る**（回帰テスト側と同じ理由。以前は落ちたときだけ 2 回払っていた）
quality_out=$(python3 .claude-plugin/scripts/validate_plugin_quality.py 2>&1) && quality_rc=0 || quality_rc=$?
if [ "$quality_rc" != "0" ]; then
  # warnings ブロックは常時数十件出るので errors の提示から外す
  # （`^warning:` は別スクリプトの書式で、ここには 1 行もマッチしない / issue #182）
  echo "$quality_out" | sed -n '/^Plugin quality validation failed/,$p'
  echo ""
  echo "  validate_plugin_quality.py の errors を解消してください"
  exit 1
fi

# 検証スクリプト自身の回帰テスト（stdlib unittest / 依存なし）
# SSoT pin は「pin の初期値」も検証と同じ関数で作るため, 切り出しが壊れていても
# 実リポジトリに対する検証は全 pin pass になる（v2.63.1 で実際に起きた）。
# 期待値を独立に構築するテストだけがこの自己整合の盲点を塞ぐ
# 起動口は run-tests.py（テストが置き去りにしたプロセスをここで回収する / issue #140）。
# **出力は 1 回の実行から取る** — 以前は「静かに実行 → 失敗したらもう一度実行して表示」
# で、落ちたときだけ実測 100 秒規模を 2 回払っていた
test_out=$(python3 .claude-plugin/scripts/run-tests.py 2>&1)
test_rc=$?
if [ "$test_rc" != "0" ]; then
  echo "$test_out" | tail -30
  echo ""
  if [ "$test_rc" = "5" ]; then
    # 5 = 1 件も収集されなかった（失敗ではなく**測れていない**）
    echo "  回帰テストが 1 件も走っていません。収集できない原因を解消してください"
  else
    echo "  .claude-plugin/scripts/tests の失敗を解消してください"
  fi
  exit 1
fi
# 残留プロセスの警告は緑判定に含めないが表示はする
# （`|| true` は grep 非マッチの exit 1 を hook の終了コードへ漏らさないため）
echo "$test_out" | grep -F "[run-tests" || true

